[Unit]
Description=PARAGON OpenAI-compatible routing proxy
Documentation=file://%PARAGON_DIR%/README.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=%PARAGON_USER%
Group=%PARAGON_GROUP%
WorkingDirectory=%PARAGON_DIR%
EnvironmentFile=-/etc/paragon/environment
ExecStart=%NODE_BIN% %PARAGON_DIR%/src/server.js
Restart=always
RestartSec=5
# Avoid tight restart loops if node or config is broken
StartLimitIntervalSec=300
StartLimitBurst=10

# CLIs (claude, codex, cursor-agent, gemini) read auth from the service user's home
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
