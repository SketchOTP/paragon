[Unit]
Description=ngrok tunnel for RouterBot
After=network-online.target routerbot.service
Wants=network-online.target

[Service]
Type=simple
User=%ROUTERBOT_USER%
Group=%ROUTERBOT_GROUP%
WorkingDirectory=%ROUTERBOT_DIR%
EnvironmentFile=-/etc/routerbot/environment
ExecStart=%NGROK_BIN% http %ROUTERBOT_PORT% --log=stdout
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
