# PARAGON environment variables (all optional)
#
# Copy to your shell profile or /etc/paragon/environment for systemd installs.
# The deprecated ROUTERBOT_* spelling of every variable below is still
# accepted for one migration release (with a deprecation warning) if the
# PARAGON_* version is unset.

# Bind address (default: 127.0.0.1 from config)
# PARAGON_HOST=127.0.0.1

# Listen port (default: 4117)
# PARAGON_PORT=4117

# API key for /v1 and /api (overrides data/config.json)
# PARAGON_API_KEY=your-secret-key

# Data directory (default: ./data)
# PARAGON_DATA_DIR=/var/lib/paragon

# Tailscale setup script overrides
# PARAGON_TAILSCALE_SERVE_PORT=9420
# PARAGON_TAILSCALE_FUNNEL_PORT=10000
# PARAGON_TAILSCALE_HOST=your-machine.tailXXXX.ts.net

# systemd install overrides
# PARAGON_USER=your-user
# PARAGON_GROUP=your-group
# PARAGON_NODE=/usr/bin/node

# Public tunnels for Cursor (see README → Cursor)
# https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
